{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "version":2,
  "buildCommand":"npm run build",
  "outputDirectory":"public",
  "rewrites":[{"source":"/api/:path*","destination":"/api"}],
  "headers":[{"source":"/(.*)","headers":[
    {"key":"Cache-Control","value":"no-store"},
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Strict-Transport-Security","value":"max-age=31536000"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
